# Copy to .env and fill in. Never commit .env.

# Postgres connection string for local work (a Neon "dev" branch works well)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Postgres connection string for the deployed app (only used by the deploy script)
PROD_DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
